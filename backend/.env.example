# ─────────────────────────────────────────────────────────────
#  CyberX OTP Server – Environment Variables
#  Copy this file to .env and fill in your real values.

# ─────────────────────────────────────────────────────────────

# SMTP Configuration
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS_REJECT_UNAUTHORIZED=true

# PostgreSQL Database
PG_HOST=
PG_PORT=
PG_DATABASE=
PG_USER=
PG_PASSWORD=

# Server
PORT=

# Allow CORS from your React dev server
FRONTEND_ORIGIN=
